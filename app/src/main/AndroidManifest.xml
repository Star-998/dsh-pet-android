<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗：显示在其他应用上层 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务常驻，避免宠物被系统回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知（Android 13+ 需要运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自启（可选，由用户在设置里开） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ↓↓↓ AI Agent 新增 ↓↓↓ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ↑↑↑ AI Agent 新增 ↑↑↑ -->

    <!-- 后台保活：申请「忽略电池优化」，减少省电策略把宠物杀掉 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ 包可见性：不声明就查不到桌面上装了哪些应用，
         助手会以为手机上没装这个 App（表现为「打开应用失败」） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ↓↓↓ AI Agent 新增：全屏对话页 ↓↓↓ -->
        <activity
            android:name=".AgentActivity"
            android:exported="false"
            android:label="@string/agent_service_name"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AiSettingsActivity"
            android:exported="false"
            android:label="AI / Agent 设置"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 注意：这里刻意不放 activity-alias。
             之前多出来的第二个桌面图标就是它造成的；而 alias 与主 Activity 同属一个包，
             在桌面长按卸载任意一个，整个应用都会被删掉。
             现在只保留一个「大肥鱼桌宠」图标，全屏对话页从主界面 / 悬浮窗标题栏「全屏」进入。 -->

        <!-- 无障碍服务：看屏幕 + 点按钮，全靠它。开关由用户在系统设置里手动打开 -->
        <service
            android:name=".AgentService"
            android:exported="true"
            android:label="@string/agent_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_service_config" />
        </service>
        <!-- ↑↑↑ AI Agent 新增 ↑↑↑ -->

        <activity
            android:name=".LinesActivity"
            android:exported="false"
            android:label="@string/lines_editor_title"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".PetService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_desktop_pet" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
